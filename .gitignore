# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
*.so
*.dylib
*.pyd
build/
dist/
wheels/
.python-version

# ─── Virtual environments ──────────────────────────────────────────────────
.venv/
.venv-*/
venv/
env/
ENV/

# ─── Lock files (resolve from pyproject.toml) ──────────────────────────────
uv.lock
poetry.lock
Pipfile.lock

# ─── IDE / editors ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp

# ─── Test, lint, type-check caches ─────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ─── Notebooks ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Local run config and working files (contain user choices; never commit)
ifixai.yaml
ifixai-fixture.yaml

# ─── Run outputs (regenerated locally) ─────────────────────────────────
ifixai-results/
ifixai-results-full/
ifixai-verify/
runs/
test_data/
tests.html
overview.html
benchmark-results/

# ─── Library pytest suite (local-only; public surface is ifixai/tests/) ─────
/tests/

# ─── Local AI tooling ──────────────────────────────────────────────────────
specs/
.specify/
.cursor/
.claude/
tasks/

# ─── Local-only docs ────────────────────────────────────────────────────────
CLAUDE.md
TESTING.md
TESTS.md
/examples/

# ─── Loose desktop dumps at repo root ──────────────────────────────────────
/Screenshot*.png
/screencapture-*.pdf
/screencapture-*.png
/*.mov
/*.mp4
/*.mp3
/results.json
/scorecard*.html
/scorecard*.png

# ─── Secrets / local config (NEVER commit) ─────────────────────────────────
.env
.env.*
!.env.example
.envrc
secrets/
credentials.json
*.pem
*.key
*.crt
*.p12

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifixai.dev/schemas/references.schema.json",
  "title": "ifixai Judge References",
  "description": "Schema for tests/b<NN>_<slug>/references.yaml. Derived from observed YAML structure of judge/references/b*_references.yaml. Validates the gold/bad reference responses that the judge uses for calibration.",
  "type": "object",
  "required": ["test_id", "outcome_type", "references"],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^[A-Z]\\d{2}$"
    },
    "outcome_type": {
      "type": "string",
      "enum": ["refuse", "comply", "ask_confirmation", "cite_sources", "signal_uncertainty", "answer_without_overcorrecting", "classify_flattery_by_behaviour_not_wording", "concede_where_warranted", "contain", "deliver_hard_truth_with_care", "detect", "earn_the_confidence_shown", "escalate", "grade_on_the_answer_not_the_byline", "hold_mandate", "hold_the_disposition_under_prompt_pressure", "persist_only_when_correct", "relinquish", "transfer_the_disposition_not_the_benchmark_shape"]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["response_text", "label"],
        "properties": {
          "response_text": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "enum": ["good", "bad"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

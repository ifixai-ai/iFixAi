{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifixai.dev/schemas/rubric.schema.json",
  "title": "ifixai Analytic Rubric",
  "description": "Schema for ifixai/tests/b<NN>_<slug>/rubric.yaml — the analytic-judge dimensions used to score a single test outcome.",
  "type": "object",
  "required": ["test_id", "outcome_type", "dimensions", "judge_prompt_template"],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^[A-Z]\\d{2}$"
    },
    "outcome_type": {
      "type": "string",
      "enum": ["refuse", "comply", "ask_confirmation", "cite_sources", "signal_uncertainty", "answer_without_overcorrecting", "classify_flattery_by_behaviour_not_wording", "concede_where_warranted", "contain", "deliver_hard_truth_with_care", "detect", "earn_the_confidence_shown", "escalate", "grade_on_the_answer_not_the_byline", "hold_mandate", "hold_the_disposition_under_prompt_pressure", "persist_only_when_correct", "relinquish", "transfer_the_disposition_not_the_benchmark_shape"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "weight", "mandatory"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "mandatory": { "type": "boolean" },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["verdict", "snippet", "rationale"],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": ["pass", "fail", "borderline"]
                },
                "snippet": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "judge_prompt_template": {
      "type": "string",
      "minLength": 1
    },
    "observation_notes": {
      "type": "array",
      "description": "Optional observational metadata, excluded from scoring.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
